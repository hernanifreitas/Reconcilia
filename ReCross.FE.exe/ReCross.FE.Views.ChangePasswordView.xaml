<?xml version="1.0" encoding="utf-8"?>
<strillsUIUserControls:UserControlFormBase x:Class="ReCross.FE.Views.ChangePasswordView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:ReCross.BE.DataObjects;assembly=ReCross.BE" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" xmlns:strillsUIUserControls="clr-namespace:Strills.WPF.UI.UserControls;assembly=Strills.WPF.UI" xmlns:strillsUIControlAdapters="clr-namespace:Strills.WPF.UI.Controls.Internal;assembly=Strills.WPF.UI" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" Height="Auto" Width="Auto" xmlns:views="clr-namespace:ReCross.FE.Views" Loaded="UserControl_Loaded">
  <StackPanel Name="SPItem" MaxWidth="500" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" DataContext="{Binding Source={StaticResource viewModelChangePassword}, Path=CurrentItem}">
    <Border Style="{StaticResource entityViewBorder}">
      <WrapPanel Orientation="Horizontal" Margin="10" Height="Auto" Width="470" VerticalAlignment="Center" HorizontalAlignment="Stretch">
        <StackPanel Width="470" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,0,20">
          <TextBlock Style="{StaticResource titleTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.ChangePasswordView, Key=L_ChangePassword}" />
        </StackPanel>
        <StackPanel Width="250" VerticalAlignment="Center" Height="40">
          <TextBlock Name="LPassword" Style="{StaticResource rightTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.ChangePasswordView, Key=L_Password}" />
        </StackPanel>
        <StackPanel Width="210" VerticalAlignment="Center" Height="50">
          <PasswordBox Name="PBPassword" Width="200" strillsUIControlAdapters:PasswordBoxAssistant.BindPassword="True" IsEnabled="True" strillsUIControlAdapters:PasswordBoxAssistant.BoundPassword="{Binding ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=Password, Mode=TwoWay}" ToolTip="{Binding ElementName=PBPassword, Path=(Validation.Errors)[0]}" Validation.Error="InvalidType_Error" />
        </StackPanel>
        <StackPanel Width="250" VerticalAlignment="Center" Height="40">
          <TextBlock Name="LNewPassword" Style="{StaticResource rightTextBlock}" Height="20" Text="{Resx ResxName=ReCross.FE.Views.ChangePasswordView, Key=L_NewPassword}" />
        </StackPanel>
        <StackPanel Width="210" VerticalAlignment="Center" Height="50">
          <PasswordBox Name="PBNewPassword" Width="200" strillsUIControlAdapters:PasswordBoxAssistant.BindPassword="True" IsEnabled="True" strillsUIControlAdapters:PasswordBoxAssistant.BoundPassword="{Binding ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=NewPassword, Mode=TwoWay}" ToolTip="{Binding ElementName=PBNewPassword, Path=(Validation.Errors)[0]}" Validation.Error="InvalidType_Error" />
        </StackPanel>
        <StackPanel Width="250" VerticalAlignment="Center" Height="40">
          <TextBlock Name="LConfirmPassword" Style="{StaticResource rightTextBlock}" Height="20" Text="{Resx ResxName=ReCross.FE.Views.ChangePasswordView, Key=L_ConfirmPassword}" />
        </StackPanel>
        <StackPanel Width="210" VerticalAlignment="Center" Height="50">
          <PasswordBox Name="PBConfirmPassword" Width="200" strillsUIControlAdapters:PasswordBoxAssistant.BindPassword="True" IsEnabled="True" strillsUIControlAdapters:PasswordBoxAssistant.BoundPassword="{Binding ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=ConfirmPassword, Mode=TwoWay}" ToolTip="{Binding ElementName=PBConfirmPassword, Path=(Validation.Errors)[0]}" Validation.Error="InvalidType_Error" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Width="470" VerticalAlignment="Bottom" HorizontalAlignment="Center">
          <Button Name="BChangePassword" Style="{StaticResource formButton}" Margin="100,0,5,0" Width="120" Command="{Binding Source={StaticResource viewModelChangePassword}, Path=CMDChangePassword}" Content="{Resx ResxName=ReCross.FE.Views.ChangePasswordView, Key=B_Change}" />
          <Button Name="BCancel" Style="{StaticResource formButton}" Margin="5,0,100,0" Width="120" Command="{Binding Source={StaticResource viewModelChangePassword}, Path=CMDCancel}" Content="{Resx ResxName=ReCross.FE.Views.ChangePasswordView, Key=B_Cancel}" />
        </StackPanel>
      </WrapPanel>
    </Border>
  </StackPanel>
</strillsUIUserControls:UserControlFormBase>