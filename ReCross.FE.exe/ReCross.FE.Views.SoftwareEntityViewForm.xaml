<?xml version="1.0" encoding="utf-8"?>
<strillsUIUserControls:UserControlFormBase x:Class="ReCross.FE.Views.SoftwareEntityViewForm" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:ReCross.BE.DataObjects;assembly=ReCross.BE" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" xmlns:strillsUIUserControls="clr-namespace:Strills.WPF.UI.UserControls;assembly=Strills.WPF.UI" xmlns:strillsUIControlAdapters="clr-namespace:Strills.WPF.UI.Controls.Internal;assembly=Strills.WPF.UI" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" Height="Auto" Width="Auto" xmlns:views="clr-namespace:ReCross.FE.Views" Loaded="UserControl_Loaded">
  <DockPanel>
    <WrapPanel Style="{StaticResource entityFormWrapPanel}" Height="430" DockPanel.Dock="Top">
      <StackPanel Width="440" VerticalAlignment="Top">
        <TextBlock Name="LFullName" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.SoftwareEntityViewForm, Key=L_FullName}" />
        <TextBox Name="TBFullName" MaxLength="50" Width="420" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=FullName}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBFullName, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="500" VerticalAlignment="Top">
        <TextBlock Name="LShortName" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.SoftwareEntityViewForm, Key=L_ShortName}" />
        <TextBox Name="TBShortName" MaxLength="30" Width="260" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=ShortName}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBShortName, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="940" VerticalAlignment="Top">
        <TextBlock Name="LSoftwareName" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.SoftwareEntityViewForm, Key=L_SoftwareName}" />
        <TextBox Name="TBSoftwareName" MaxLength="50" Width="420" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=SoftwareName}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBFullName, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="220" VerticalAlignment="Top">
        <TextBlock Name="LPhoneNumber" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.SoftwareEntityViewForm, Key=L_PhoneNumber}" />
        <TextBox Name="TBMobilePhone" MaxLength="9" Width="90" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=MobilePhone}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBMobilePhone, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="360" VerticalAlignment="Top">
        <TextBlock Name="LEmail" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.SoftwareEntityViewForm, Key=L_Email}" />
        <TextBox Name="TBEmail" MaxLength="50" Width="310" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=Email}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBEmail, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="360" VerticalAlignment="Top">
        <TextBlock Name="LWebSite" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.SoftwareEntityViewForm, Key=L_WebSite}" />
        <TextBox Name="TBWebSite" MaxLength="50" Width="340" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=WebSite}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBWebSite, Path=(Validation.Errors)[0]}" />
      </StackPanel>
    </WrapPanel>
    <DockPanel Dock="Bottom">
      <StackPanel Style="{StaticResource formNavigationStackPanel}" DockPanel.Dock="Left">
        <Button Name="BBack" Style="{StaticResource formButton}" Margin="0,0,10,0" Content="{Resx ResxName=Strills.WPF.Localization.Resources.ToolBar, Key=L_Back}">
          <strillsUICommands:CommandBehaviorCollection.Behaviors>
            <strillsUICommands:BehaviorBinding Event="Click" Command="strillsUIUserControls:UserControlItemBase.CMDViewItemList" />
            <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Source={StaticResource viewModelSoftwareEntity}, Path=CMDCancel}" />
          </strillsUICommands:CommandBehaviorCollection.Behaviors>
        </Button>
      </StackPanel>
      <StackPanel Style="{StaticResource formButtonsStackPanel}" DockPanel.Dock="Left">
        <Button Name="BConfirm" Style="{StaticResource formButton}" Margin="0,0,10,0" Content="{Resx ResxName=Strills.WPF.Localization.Resources.ToolBar, Key=L_Confirm}" Command="{Binding Source={StaticResource viewModelSoftwareEntity}, Path=CMDConfirm}">
          <strillsUICommands:CommandBehaviorCollection.Behaviors>
            <strillsUICommands:BehaviorBinding Event="Click" Command="strillsUIUserControls:UserControlItemBase.CMDViewItemList" />
          </strillsUICommands:CommandBehaviorCollection.Behaviors>
        </Button>
        <Button Name="BCancel" Style="{StaticResource formButton}" Margin="0,0,10,0" Content="{Resx ResxName=Strills.WPF.Localization.Resources.ToolBar, Key=L_Cancel}">
          <strillsUICommands:CommandBehaviorCollection.Behaviors>
            <strillsUICommands:BehaviorBinding Event="Click" Command="strillsUIUserControls:UserControlItemBase.CMDViewItemList" />
            <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Source={StaticResource viewModelSoftwareEntity}, Path=CMDCancel}" />
          </strillsUICommands:CommandBehaviorCollection.Behaviors>
        </Button>
      </StackPanel>
    </DockPanel>
  </DockPanel>
</strillsUIUserControls:UserControlFormBase>