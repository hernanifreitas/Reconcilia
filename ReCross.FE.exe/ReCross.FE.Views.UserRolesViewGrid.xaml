<?xml version="1.0" encoding="utf-8"?>
<strillsUIUserControls:UserControlGridBase x:Class="ReCross.FE.Views.UserRolesViewGrid" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:ReCross.BE.DataObjects;assembly=ReCross.BE" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" xmlns:strillsUIUserControls="clr-namespace:Strills.WPF.UI.UserControls;assembly=Strills.WPF.UI" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" Height="Auto" Width="Auto" xmlns:views="clr-namespace:ReCross.FE.Views" Loaded="UserControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="columnFunctionality">
        <Control Name="functionality" Focusable="False">
          <Control.Template>
            <ControlTemplate>
              <StackPanel>
                <TextBlock TextAlignment="Center" Text="{Binding Path=Functionality.Abbreviation}" ToolTip="{Binding Path=Functionality.Description}" />
              </StackPanel>
            </ControlTemplate>
          </Control.Template>
        </Control>
        <DataTemplate.Triggers>
          <DataTrigger Value="True" Binding="{Binding Path=IsEdited, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItemExtended}}}">
            <Setter TargetName="functionality" Property="Control.Template">
              <Setter.Value>
                <ControlTemplate>
                  <ComboBox Name="CBFunctionality" Width="290" Height="25" SelectedItem="{Binding ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=Functionality}" ItemsSource="{Binding Path=FunctionalityList.Source, Source={StaticResource viewModelUserRoles}}" Validation.Error="InvalidType_Error">
                    <FrameworkElement.Resources>
                      <ResourceDictionary>
                        <DataTemplate x:Key="{DataTemplateKey {x:Type models:Functionality}}" DataType="{x:Type models:Functionality}">
                          <TextBlock Text="{Binding Abbreviation}" ToolTip="{Binding Description}" />
                        </DataTemplate>
                      </ResourceDictionary>
                    </FrameworkElement.Resources>
                  </ComboBox>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
      <DataTemplate x:Key="columnId">
        <Control Name="id" Focusable="False">
          <Control.Template>
            <ControlTemplate>
              <TextBlock TextAlignment="Right" Text="{Binding Path=Abbreviation}" ToolTip="{Binding Path=Description}" />
            </ControlTemplate>
          </Control.Template>
        </Control>
        <DataTemplate.Triggers>
          <DataTrigger Value="True" Binding="{Binding Path=IsEdited, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItemExtended}}}">
            <Setter TargetName="id" Property="Control.Template">
              <Setter.Value>
                <ControlTemplate>
                  <ComboBox Name="CBId" Width="490" Height="25" Validation.Error="InvalidType_Error">
                    <Selector.SelectedItem>
                      <MultiBinding Converter="{x:Static viewModels:SelectedRoleConverter.Instance}" ConverterParameter="{StaticResource viewModelUserRoles}">
                        <Binding Path="DataContext" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ListViewItemExtended}}" />
                      </MultiBinding>
                    </Selector.SelectedItem>
                    <ItemsControl.ItemsSource>
                      <MultiBinding Converter="{x:Static viewModels:RolesConverter.Instance}" ConverterParameter="{StaticResource viewModelUserRoles}">
                        <Binding Path="DataContext.Functionality" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ListViewItemExtended}}" />
                        <Binding Path="DataContext" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type ListViewItemExtended}}" />
                      </MultiBinding>
                    </ItemsControl.ItemsSource>
                    <FrameworkElement.Resources>
                      <ResourceDictionary>
                        <DataTemplate x:Key="{DataTemplateKey {x:Type models:Role}}" DataType="{x:Type models:Role}">
                          <TextBlock Text="{Binding Abbreviation}" ToolTip="{Binding Description}" />
                        </DataTemplate>
                      </ResourceDictionary>
                    </FrameworkElement.Resources>
                  </ComboBox>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Style="{StaticResource entityGridStackPanel}">
    <ListViewExtended Name="LVParametrization_Users_UserRoles" MaxHeight="285" MaxWidth="900" ItemContainerStyle="{StaticResource itemStyle}" CommandAddItem="{Binding Source={StaticResource viewModelUserRoles}, Path=CMDAddItem}" CommandEditItem="{Binding Source={StaticResource viewModelUserRoles}, Path=CMDEditItem}" CommandRemoveItem="{Binding Source={StaticResource viewModelUserRoles}, Path=CMDRemoveItem}" CommandConfirm="{Binding Source={StaticResource viewModelUserRoles}, Path=CMDConfirm}" CommandCancel="{Binding Source={StaticResource viewModelUserRoles}, Path=CMDCancel}" ItemsSource="{Binding}">
      <ListView.View>
        <GridView ColumnHeaderTemplate="{StaticResource headerTemplateTransparent}" ColumnHeaderContainerStyle="{StaticResource gridViewHeaderStyle}">
          <GridViewColumnExtended Width="302" CellTemplate="{StaticResource columnFunctionality}" Header="{Resx ResxName=ReCross.FE.Views.UserRolesViewGrid, Key=L_Functionality}" />
          <GridViewColumnExtended Width="500" CellTemplate="{StaticResource columnId}" Header="{Resx ResxName=ReCross.FE.Views.UserRolesViewGrid, Key=L_Id}" />
          <GridViewColumn HeaderTemplate="{StaticResource operationsEditableGridDetailViewHeader}" CellTemplate="{StaticResource operationsEditableGridDetailViewCell}" />
        </GridView>
      </ListView.View>
    </ListViewExtended>
  </StackPanel>
</strillsUIUserControls:UserControlGridBase>