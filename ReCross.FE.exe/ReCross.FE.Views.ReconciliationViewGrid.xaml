<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ReCross.FE.Views.ReconciliationViewGrid" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" xmlns:strillsUIUserControls="clr-namespace:Strills.WPF.UI.UserControls;assembly=Strills.WPF.UI" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" Height="Auto" Width="Auto" xmlns:views="clr-namespace:ReCross.FE.Views" Loaded="UserControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="reconciliationGridViewHeader">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
          <Button Name="BSelect" ToolTip="Botão Esq - Seleccionar Todos. Botão Dir - Desseleccionar Todos" Style="{StaticResource gridButton}" Command="{Binding Path=CMDSelectAll, Source={StaticResource viewModelReconciliation}}">
            <Control.Background>
              <ImageBrush ImageSource="..\Images\Select.png" />
            </Control.Background>
            <strillsUICommands:CommandBehaviorCollection.Behaviors>
              <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Path=CMDSelectAllItems, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewExtended}}}">
                <strillsUICommands:BehaviorBinding.CommandParameter>
                  <s:Boolean>True</s:Boolean>
                </strillsUICommands:BehaviorBinding.CommandParameter>
              </strillsUICommands:BehaviorBinding>
              <strillsUICommands:BehaviorBinding Event="MouseRightButtonDown" Command="{Binding Path=CMDSelectAllItems, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewExtended}}}">
                <strillsUICommands:BehaviorBinding.CommandParameter>
                  <s:Boolean>False</s:Boolean>
                </strillsUICommands:BehaviorBinding.CommandParameter>
              </strillsUICommands:BehaviorBinding>
            </strillsUICommands:CommandBehaviorCollection.Behaviors>
          </Button>
          <Button Name="BUnlinkSelected" ToolTip="Desfazer ligações seleccionadas de movimentos contabilísticos com movimentos bancários" Style="{StaticResource gridButton}" Command="{Binding Path=CMDUnlinkSelected, Source={StaticResource viewModelReconciliation}}" CommandParameter="{Binding Path=SelectedItems, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewExtended}}}" Visibility="{Binding Source={x:Static Application.Current}, Path=CurrentDataContext.DataFilters.HasDataSelected, Converter={x:Static viewModels:ReconciliationClosedConverter.Instance}, UpdateSourceTrigger=PropertyChanged, ConverterParameter={StaticResource viewModelReconciliation}}">
            <Control.Background>
              <ImageBrush ImageSource="..\Images\Unlink.png" />
            </Control.Background>
          </Button>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="reconciliationGridViewCell">
        <StackPanel Orientation="Horizontal" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Name="BUnlink" ToolTip="Desfazer ligação de movimento contabilístico com movimentos bancário" Style="{StaticResource gridButton}" Command="{Binding Path=CMDUnlink, Source={StaticResource viewModelReconciliation}}" CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItemExtended}}}">
            <Control.Background>
              <ImageBrush ImageSource="..\Images\Unlink.png" />
            </Control.Background>
          </Button>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Style="{StaticResource entityGridStackPanel}" Width="900">
    <ListViewExtended Name="LVReconciliations" ItemsSource="{Binding}">
      <ListView.View>
        <GridView ColumnHeaderTemplate="{StaticResource headerTemplateTransparent}" ColumnHeaderContainerStyle="{StaticResource gridViewHeaderStyle}">
          <GridViewColumnExtended Width="105" SortPropertyName="MonthYear" Header="{Resx ResxName=ReCross.FE.Views.ReconciliationViewGrid, Key=L_MonthYear}" DisplayMemberBinding="{Binding Path=MonthYear}" />
          <GridViewColumnExtended Width="355" SortPropertyName="AccountMovementGroup" Header="{Resx ResxName=ReCross.FE.Views.ReconciliationViewGrid, Key=L_AccountAmount}">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding AccountMovementGroup}" ToolTip="{Binding AccountMovementAmmountsWithDescrGroup}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumnExtended>
          <GridViewColumnExtended Width="355" SortPropertyName="BankMovementGroup" Header="{Resx ResxName=ReCross.FE.Views.ReconciliationViewGrid, Key=L_BankAmount}">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding BankMovementGroup}" ToolTip="{Binding BankMovementAmmountsWithDescrGroup}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumnExtended>
          <GridViewColumn HeaderTemplate="{StaticResource reconciliationGridViewHeader}" CellTemplate="{StaticResource reconciliationGridViewCell}" />
        </GridView>
      </ListView.View>
    </ListViewExtended>
  </StackPanel>
</UserControl>