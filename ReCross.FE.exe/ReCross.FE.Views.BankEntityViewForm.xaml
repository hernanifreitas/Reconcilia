<?xml version="1.0" encoding="utf-8"?>
<strillsUIUserControls:UserControlFormBase x:Class="ReCross.FE.Views.BankEntityViewForm" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:ReCross.BE.DataObjects;assembly=ReCross.BE" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" xmlns:strillsUIUserControls="clr-namespace:Strills.WPF.UI.UserControls;assembly=Strills.WPF.UI" xmlns:strillsUIControlAdapters="clr-namespace:Strills.WPF.UI.Controls.Internal;assembly=Strills.WPF.UI" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" Height="Auto" Width="Auto" xmlns:views="clr-namespace:ReCross.FE.Views" Loaded="UserControl_Loaded">
  <DockPanel>
    <WrapPanel Style="{StaticResource entityFormWrapPanel}" Height="430" DockPanel.Dock="Top">
      <StackPanel Width="220" VerticalAlignment="Center">
        <TextBlock Name="LCode" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankEntityViewForm, Key=L_Code}" />
        <TextBox Name="TBCode" MaxLength="4" Width="100" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=Code, Mode=TwoWay}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBCode, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="720" VerticalAlignment="Center">
        <TextBlock Name="LFiscalNumber" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankEntityViewForm, Key=L_FiscalNumber}" />
        <TextBox Name="TBFiscalNumber" MaxLength="50" Width="200" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=FiscalNumber}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBFiscalNumber, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="220" VerticalAlignment="Center">
        <TextBlock Name="LShortName" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankEntityViewForm, Key=L_ShortName}" />
        <TextBox Name="TBShortName" MaxLength="20" Width="200" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=ShortName}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBShortName, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="720" VerticalAlignment="Center">
        <TextBlock Name="LFullName" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankEntityViewForm, Key=L_FullName}" />
        <TextBox Name="TBFullName" MaxLength="50" Width="400" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=FullName}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBFullName, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="720" VerticalAlignment="Center">
        <TextBlock Name="LAddress" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankEntityViewForm, Key=L_Address}" />
        <TextBox Name="TBAddress" MaxLength="200" Width="620" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=Address}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBAddress, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="220" VerticalAlignment="Center">
        <TextBlock Name="LPhoneNumber" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankEntityViewForm, Key=L_PhoneNumber}" />
        <TextBox Name="TBPhoneNumber" MaxLength="9" Width="200" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=PhoneNumber}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBPhoneNumber, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="440" VerticalAlignment="Center">
        <TextBlock Name="LEmail" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankEntityViewForm, Key=L_Email}" />
        <TextBox Name="TBEmail" MaxLength="50" Width="310" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=Email}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBEmail, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="500" VerticalAlignment="Center">
        <TextBlock Name="LWebSite" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankEntityViewForm, Key=L_WebSite}" />
        <TextBox Name="TBWebSite" MaxLength="50" Width="480" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=WebSite}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBWebSite, Path=(Validation.Errors)[0]}" />
      </StackPanel>
    </WrapPanel>
    <DockPanel Dock="Bottom">
      <StackPanel Style="{StaticResource formNavigationStackPanel}" DockPanel.Dock="Left">
        <Button Name="BBack" Style="{StaticResource formButton}" Margin="0,0,10,0" Content="{Resx ResxName=Strills.WPF.Localization.Resources.ToolBar, Key=L_Back}">
          <strillsUICommands:CommandBehaviorCollection.Behaviors>
            <strillsUICommands:BehaviorBinding Event="Click" Command="strillsUIUserControls:UserControlItemBase.CMDViewItemList" />
            <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Source={StaticResource viewModelBankEntity}, Path=CMDCancel}" />
          </strillsUICommands:CommandBehaviorCollection.Behaviors>
        </Button>
      </StackPanel>
      <StackPanel Style="{StaticResource formButtonsStackPanel}" DockPanel.Dock="Left">
        <Button Name="BConfirm" Style="{StaticResource formButton}" Margin="0,0,10,0" Content="{Resx ResxName=Strills.WPF.Localization.Resources.ToolBar, Key=L_Confirm}" Command="{Binding Source={StaticResource viewModelBankEntity}, Path=CMDConfirm}">
          <strillsUICommands:CommandBehaviorCollection.Behaviors>
            <strillsUICommands:BehaviorBinding Event="Click" Command="strillsUIUserControls:UserControlItemBase.CMDViewItemList" />
          </strillsUICommands:CommandBehaviorCollection.Behaviors>
        </Button>
        <Button Name="BCancel" Style="{StaticResource formButton}" Margin="0,0,10,0" Content="{Resx ResxName=Strills.WPF.Localization.Resources.ToolBar, Key=L_Cancel}">
          <strillsUICommands:CommandBehaviorCollection.Behaviors>
            <strillsUICommands:BehaviorBinding Event="Click" Command="strillsUIUserControls:UserControlItemBase.CMDViewItemList" />
            <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Source={StaticResource viewModelBankEntity}, Path=CMDCancel}" />
          </strillsUICommands:CommandBehaviorCollection.Behaviors>
        </Button>
      </StackPanel>
    </DockPanel>
  </DockPanel>
</strillsUIUserControls:UserControlFormBase>