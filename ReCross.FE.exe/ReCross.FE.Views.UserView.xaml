<?xml version="1.0" encoding="utf-8"?>
<UserControlItemBase x:Class="ReCross.FE.Views.UserView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" xmlns:views="clr-namespace:ReCross.FE.Views" xmlns:strillsUIControls="clr-namespace:Strills.WPF.UI.Controls;assembly=Strills.WPF.UI" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" Height="Auto" Width="Auto" DataContext="{Binding Source={StaticResource viewModelUser}, Path=DataList}" Loaded="UserControl_Loaded">
  <StackPanel>
    <StackPanel Name="SPItemList" Style="{StaticResource itemListStackPanel}">
      <Border Style="{StaticResource entityViewBorder}">
        <WrapPanel Style="{StaticResource itemListWrapPanel}">
          <views:UserViewGrid />
        </WrapPanel>
      </Border>
    </StackPanel>
    <StackPanel Name="SPItem" Style="{StaticResource itemStackPanel}">
      <Border Style="{StaticResource entityViewBorder}">
        <views:UserViewForm />
      </Border>
    </StackPanel>
  </StackPanel>
</UserControlItemBase>