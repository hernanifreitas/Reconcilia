<?xml version="1.0" encoding="utf-8"?>
<strillsUIUserControls:UserControlFormBase x:Class="ReCross.FE.Views.BankAccountViewForm" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:strillsConverters="clr-namespace:Strills.WPF.Localization.Converters;assembly=Strills.WPF.Localization" xmlns:strillsUIUserControls="clr-namespace:Strills.WPF.UI.UserControls;assembly=Strills.WPF.UI" xmlns:strillsUIControlAdapters="clr-namespace:Strills.WPF.UI.Controls.Internal;assembly=Strills.WPF.UI" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" xmlns:converters="clr-namespace:ReCross.FE.Converters" xmlns:models="clr-namespace:ReCross.BE.DataObjects;assembly=ReCross.BE" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" Height="Auto" Width="Auto" xmlns:views="clr-namespace:ReCross.FE.Views" Loaded="UserControl_Loaded">
  <DockPanel>
    <WrapPanel Style="{StaticResource entityFormWrapPanel}" DockPanel.Dock="Top">
      <StackPanel Width="220" VerticalAlignment="Center">
        <TextBlock Name="LEntity" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankAccountViewForm, Key=L_Entity}" />
        <TextBox Name="TBEntity" MaxLength="50" Width="200" IsReadOnly="True" Text="{Binding Source={x:Static Application.Current}, Path=CurrentDataContext.DataFilters.CurrentEntity.ShortName}" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBEntity, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="220" VerticalAlignment="Center">
        <TextBlock Name="LBankEntity" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankAccountViewForm, Key=L_BankEntity}" />
        <ComboBox Name="CBBankEntity" Width="200" SelectedItem="{Binding ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=BankEntity, Converter={x:Static strillsConverters:ComboBoxNullItemConverter.Instance}}" Validation.Error="InvalidType_Error">
          <ItemsControl.ItemsSource>
            <MultiBinding Converter="{x:Static converters:ComboBoxItemsConverter.Instance}" ConverterParameter="BankEntities">
              <Binding Source="{x:Static Application.Current}" Path="StateData.IsLoggedIn" Mode="TwoWay" />
              <Binding Source="{x:Static Application.Current}" Path="CurrentDataContext.ParamData.BankEntities" Mode="TwoWay" />
            </MultiBinding>
          </ItemsControl.ItemsSource>
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <DataTemplate x:Key="{DataTemplateKey {x:Type models:BankEntity}}" DataType="{x:Type models:BankEntity}">
                <TextBlock Text="{Binding ShortName}" />
              </DataTemplate>
            </ResourceDictionary>
          </FrameworkElement.Resources>
        </ComboBox>
        <ContentPresenter Height="30" Content="{Binding ElementName=CBBankEntity, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="500" VerticalAlignment="Center">
        <TextBlock Name="LBankBranch" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankAccountViewForm, Key=L_BankBranch}" />
        <TextBox Name="TBBankBranch" MaxLength="50" Width="200" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=BankBranch}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBBankBranch, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="220" VerticalAlignment="Center">
        <TextBlock Name="LAccountNumber" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankAccountViewForm, Key=L_AccountNumber}" />
        <TextBox Name="TBAccountNumber" MaxLength="20" Width="200" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=AccountNumber}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBAccountNumber, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="720" VerticalAlignment="Center">
        <TextBlock Name="LAbbreviation" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankAccountViewForm, Key=L_Abbreviation}" />
        <TextBox Name="TBAbbreviation" MaxLength="50" Width="420" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=Abbreviation}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBAbbreviation, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="440" VerticalAlignment="Center">
        <TextBlock Name="LNIB" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankAccountViewForm, Key=L_NIB}" />
        <TextBox Name="TBNIB" MaxLength="21" Width="400" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=NIB}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBNIB, Path=(Validation.Errors)[0]}" />
      </StackPanel>
      <StackPanel Width="500" VerticalAlignment="Center">
        <TextBlock Name="LIBAN" Style="{StaticResource formTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.BankAccountViewForm, Key=L_IBAN}" />
        <TextBox Name="TBIBAN" MaxLength="50" Width="400" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=IBAN}" Validation.Error="InvalidType_Error" />
        <ContentPresenter Height="30" Content="{Binding ElementName=TBIBAN, Path=(Validation.Errors)[0]}" />
      </StackPanel>
    </WrapPanel>
    <DockPanel Dock="Bottom">
      <StackPanel Style="{StaticResource formNavigationStackPanel}" DockPanel.Dock="Left">
        <Button Name="BBack" Style="{StaticResource formButton}" Margin="0,0,10,0" Content="{Resx ResxName=Strills.WPF.Localization.Resources.ToolBar, Key=L_Back}">
          <strillsUICommands:CommandBehaviorCollection.Behaviors>
            <strillsUICommands:BehaviorBinding Event="Click" Command="strillsUIUserControls:UserControlItemBase.CMDViewItemList" />
            <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Source={StaticResource viewModelBankAccount}, Path=CMDCancel}" />
          </strillsUICommands:CommandBehaviorCollection.Behaviors>
        </Button>
      </StackPanel>
      <StackPanel Style="{StaticResource formButtonsStackPanel}" DockPanel.Dock="Left">
        <Button Name="BConfirm" Style="{StaticResource formButton}" Margin="0,0,10,0" Content="{Resx ResxName=Strills.WPF.Localization.Resources.ToolBar, Key=L_Confirm}" Command="{Binding Source={StaticResource viewModelBankAccount}, Path=CMDConfirm}">
          <strillsUICommands:CommandBehaviorCollection.Behaviors>
            <strillsUICommands:BehaviorBinding Event="Click" Command="strillsUIUserControls:UserControlItemBase.CMDViewItemList" />
          </strillsUICommands:CommandBehaviorCollection.Behaviors>
        </Button>
        <Button Name="BCancel" Style="{StaticResource formButton}" Margin="0,0,10,0" Content="{Resx ResxName=Strills.WPF.Localization.Resources.ToolBar, Key=L_Cancel}">
          <strillsUICommands:CommandBehaviorCollection.Behaviors>
            <strillsUICommands:BehaviorBinding Event="Click" Command="strillsUIUserControls:UserControlItemBase.CMDViewItemList" />
            <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Source={StaticResource viewModelBankAccount}, Path=CMDCancel}" />
          </strillsUICommands:CommandBehaviorCollection.Behaviors>
        </Button>
      </StackPanel>
    </DockPanel>
  </DockPanel>
</strillsUIUserControls:UserControlFormBase>