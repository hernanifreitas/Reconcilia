<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ReCross.FE.Views.CompanyEntityViewGrid" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" xmlns:strillsUIUserControls="clr-namespace:Strills.WPF.UI.UserControls;assembly=Strills.WPF.UI" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" Height="Auto" Width="Auto" xmlns:views="clr-namespace:ReCross.FE.Views" Loaded="UserControl_Loaded">
  <StackPanel Style="{StaticResource entityGridStackPanel}">
    <ListViewExtended Name="LVParametrization_Companies" MaxHeight="470" ItemsSource="{Binding}" CommandAddItem="{Binding Source={StaticResource viewModelCompanyEntity}, Path=CMDAddItem}" CommandEditItem="{Binding Source={StaticResource viewModelCompanyEntity}, Path=CMDEditItem}" CommandRemoveItem="{Binding Source={StaticResource viewModelCompanyEntity}, Path=CMDRemoveItem}">
      <strillsUICommands:CommandBehaviorCollection.Behaviors>
        <strillsUICommands:BehaviorBinding Event="MouseDoubleClick" Command="{Binding Source={StaticResource viewModelCompanyEntity}, Path=CMDViewItem}" />
        <strillsUICommands:BehaviorBinding Event="MouseDoubleClick" Command="strillsUIUserControls:UserControlItemBase.CMDViewItem" />
      </strillsUICommands:CommandBehaviorCollection.Behaviors>
      <ListView.View>
        <GridView ColumnHeaderTemplate="{StaticResource headerTemplateTransparent}" ColumnHeaderContainerStyle="{StaticResource gridViewHeaderStyle}">
          <GridViewColumnExtended Width="355" SortPropertyName="FullName" Header="{Resx ResxName=ReCross.FE.Views.CompanyEntityViewGrid, Key=L_FullName}" DisplayMemberBinding="{Binding Path=FullName}" />
          <GridViewColumnExtended Width="155" SortPropertyName="ShortName" Header="{Resx ResxName=ReCross.FE.Views.CompanyEntityViewGrid, Key=L_ShortName}" DisplayMemberBinding="{Binding Path=ShortName}" />
          <GridViewColumnExtended Width="150" SortPropertyName="FiscalNumber" Header="{Resx ResxName=ReCross.FE.Views.CompanyEntityViewGrid, Key=L_FiscalNumber}" DisplayMemberBinding="{Binding Path=FiscalNumber}" />
          <GridViewColumnExtended Width="180" SortPropertyName="PhoneNumber" Header="{Resx ResxName=ReCross.FE.Views.CompanyEntityViewGrid, Key=L_PhoneNumber}" DisplayMemberBinding="{Binding Path=PhoneNumber}" />
          <GridViewColumn HeaderTemplate="{StaticResource operationsGridViewHeader}" CellTemplate="{StaticResource operationsGridViewCell}" />
        </GridView>
      </ListView.View>
    </ListViewExtended>
  </StackPanel>
</UserControl>