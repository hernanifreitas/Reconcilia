<?xml version="1.0" encoding="utf-8"?>
<strillsUIUserControls:UserControlItemBase x:Class="ReCross.FE.Views.BankMovementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:strillsUIUserControls="clr-namespace:Strills.WPF.UI.UserControls;assembly=Strills.WPF.UI" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" xmlns:converters="clr-namespace:ReCross.FE.Converters" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" xmlns:views="clr-namespace:ReCross.FE.Views" Height="Auto" Width="Auto" DataContext="{Binding Source={StaticResource viewModelBankMovement}, Path=DataList}" Loaded="UserControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="toolButton" TargetType="{x:Type Button}" BasedOn="{StaticResource button}">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Margin" Value="5,0,5,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="Background">
          <Setter.Value>
            <ImageBrush ImageSource="..\Images\Folder.png" />
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel>
    <StackPanel Name="SPItemList" Style="{StaticResource itemListStackPanel}">
      <Border Style="{StaticResource entityViewBorder}">
        <WrapPanel Style="{StaticResource itemListWrapPanel}">
          <views:MovementFilterView />
          <views:BankMovementViewGrid>
            <FrameworkElement.DataContext>
              <MultiBinding Converter="{x:Static viewModels:BankMovementConverter.Instance}" ConverterParameter="{StaticResource viewModelBankMovement}">
                <Binding Source="{x:Static Application.Current}" Path="CurrentDataContext.DataFilters.CurrentBankAccount" />
                <Binding Source="{x:Static Application.Current}" Mode="TwoWay" Path="CurrentDataContext.DataFilters.CurrentYear" UpdateSourceTrigger="PropertyChanged" />
                <Binding Source="{x:Static Application.Current}" Mode="TwoWay" Path="CurrentDataContext.DataFilters.CurrentMonth" UpdateSourceTrigger="PropertyChanged" />
              </MultiBinding>
            </FrameworkElement.DataContext>
          </views:BankMovementViewGrid>
          <StackPanel VerticalAlignment="Top" Orientation="Vertical">
            <Button Name="BImport" Style="{StaticResource toolButton}" ToolTip="Importar movimentos bancários da conta seleccionada" IsEnabled="{Binding Source={x:Static Application.Current}, Path=StateData.IsNotEditingMode, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Source={x:Static Application.Current}, Path=CurrentDataContext.DataFilters.HasDataSelected, UpdateSourceTrigger=PropertyChanged, Converter={x:Static converters:VisibilityAsDataConverter.Instance}, ConverterParameter=Import}">
              <Control.Background>
                <ImageBrush ImageSource="..\Images\Folder.png" />
              </Control.Background>
              <strillsUICommands:CommandBehaviorCollection.Behaviors>
                <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Source={StaticResource viewModelAccountMovement}, Path=CMDLoad}" />
                <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Source={StaticResource viewModelBankMovement}, Path=CMDImport}" />
              </strillsUICommands:CommandBehaviorCollection.Behaviors>
            </Button>
            <Button Name="BPrint" Style="{StaticResource toolButton}" VerticalAlignment="Bottom" ToolTip="Imprimir mapa de reconciliação" Command="{Binding Source={StaticResource viewModelBankMovement}, Path=CMDPrint}" Visibility="{Binding Source={x:Static Application.Current}, Path=CurrentDataContext.DataFilters.HasDataSelected, UpdateSourceTrigger=PropertyChanged, Converter={x:Static converters:VisibilityAsDataConverter.Instance}, ConverterParameter=Visible}">
              <Control.Background>
                <ImageBrush ImageSource="..\Images\Print.png" />
              </Control.Background>
            </Button>
            <Button Name="BRemoveAll" Style="{StaticResource toolButton}" VerticalAlignment="Bottom" ToolTip="Remover todos os movimentos deste mês" Command="{Binding Source={StaticResource viewModelBankMovement}, Path=CMDRemoveAll}" Visibility="{Binding Source={x:Static Application.Current}, Path=CurrentDataContext.DataFilters.HasDataSelected, UpdateSourceTrigger=PropertyChanged, Converter={x:Static converters:VisibilityAsDataConverter.Instance}, ConverterParameter=Visible}">
              <Control.Background>
                <ImageBrush ImageSource="..\Images\Remove.png" />
              </Control.Background>
            </Button>
          </StackPanel>
        </WrapPanel>
      </Border>
    </StackPanel>
    <StackPanel Name="SPItem" Style="{StaticResource itemStackPanel}" />
  </StackPanel>
</strillsUIUserControls:UserControlItemBase>