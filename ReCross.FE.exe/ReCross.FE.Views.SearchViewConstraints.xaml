<?xml version="1.0" encoding="utf-8"?>
<strillsUIUserControls:UserControlFormBase x:Class="ReCross.FE.Views.SearchViewConstraints" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:ReCross.BE.DataObjects;assembly=ReCross.BE" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" xmlns:views="clr-namespace:ReCross.FE.Views" xmlns:strillsConverters="clr-namespace:Strills.WPF.Localization.Converters;assembly=Strills.WPF.Localization" xmlns:strillsUIUserControls="clr-namespace:Strills.WPF.UI.UserControls;assembly=Strills.WPF.UI" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" xmlns:strillsUIControlAdapters="clr-namespace:Strills.WPF.UI.Controls.Internal;assembly=Strills.WPF.UI" Height="Auto" Width="Auto" Loaded="UserControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="calendarButton" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Width" Value="70" />
        <Setter Property="Height" Value="70" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="IsEnabled" Value="{Binding Source={x:Static Application.Current}, Path=StateData.IsNotEditingMode, UpdateSourceTrigger=PropertyChanged}" />
        <Setter Property="strillsUICommands:CommandBehavior.Event" Value="Click" />
        <Setter Property="strillsUICommands:CommandBehavior.Command" Value="{Binding Path=CMDChangeMonth, Source={StaticResource viewModelSearch}}" />
        <Setter Property="Background">
          <Setter.Value>
            <ImageBrush ImageSource="..\Images\BGCalendar.png" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="calendarMonthTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource textBlock}">
        <Setter Property="Margin" Value="10,2,0,0" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="calendarNumberTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource textBlock}">
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Verdana" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <WrapPanel Name="SPItem" Orientation="Horizontal" Margin="10" Width="940" VerticalAlignment="Center" HorizontalAlignment="Stretch" DataContext="{Binding Source={StaticResource viewModelSearch}}">
    <StackPanel Orientation="Horizontal" Width="235" Margin="0">
      <TextBlock Name="LBankEntity" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="15" Text="{Resx ResxName=ReCross.FE.Views.SearchViewConstraints, Key=L_BankEntity}" />
      <ComboBox Name="CBBankEntity" Width="150" Height="25" SelectedItem="{Binding Source={x:Static Application.Current}, Path=CurrentDataContext.DataFilters.CurrentBankEntity}" IsEnabled="{Binding Source={x:Static Application.Current}, Path=StateData.IsNotEditingMode, UpdateSourceTrigger=PropertyChanged}">
        <ItemsControl.ItemsSource>
          <MultiBinding Converter="{x:Static viewModels:BankEntityConverter.Instance}" ConverterParameter="{StaticResource viewModelMovementFilter}">
            <Binding Source="{x:Static Application.Current}" Path="CurrentDataContext.DataFilters.CurrentEntity" />
          </MultiBinding>
        </ItemsControl.ItemsSource>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <DataTemplate x:Key="{DataTemplateKey {x:Type models:Entity}}" DataType="{x:Type models:Entity}">
              <TextBlock Text="{Binding ShortName}" ToolTip="{Binding FullName}" />
            </DataTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
      </ComboBox>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Width="354">
      <TextBlock Name="LBankAccount" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="15" Text="{Resx ResxName=ReCross.FE.Views.SearchViewConstraints, Key=L_BankAccount}" />
      <ComboBox Name="CBBankAccount" Width="270" Height="25" SelectedItem="{Binding Source={x:Static Application.Current}, Path=CurrentDataContext.DataFilters.CurrentBankAccount}" IsEnabled="{Binding Source={x:Static Application.Current}, Path=StateData.IsNotEditingMode, UpdateSourceTrigger=PropertyChanged}">
        <ItemsControl.ItemsSource>
          <MultiBinding Converter="{x:Static viewModels:BankAccountConverter.Instance}" ConverterParameter="{StaticResource viewModelMovementFilter}">
            <Binding Source="{x:Static Application.Current}" Path="CurrentDataContext.DataFilters.CurrentEntity" />
            <Binding Source="{x:Static Application.Current}" Path="CurrentDataContext.DataFilters.CurrentBankEntity" />
          </MultiBinding>
        </ItemsControl.ItemsSource>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <DataTemplate x:Key="{DataTemplateKey {x:Type models:BankAccount}}" DataType="{x:Type models:BankAccount}">
              <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}" />
            </DataTemplate>
          </ResourceDictionary>
        </FrameworkElement.Resources>
      </ComboBox>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Width="350">
      <Button Name="BSearch" Width="160" Style="{StaticResource formButton}" Margin="10,0,0,0" Content="{Resx ResxName=ReCross.FE.Views.SearchViewConstraints, Key=L_Search}" Command="{Binding Source={StaticResource viewModelSearch}, Path=CMDSearch}" />
      <Button Name="BClean" Width="160" Style="{StaticResource formButton}" Margin="10,0,0,0" Content="{Resx ResxName=ReCross.FE.Views.SearchViewConstraints, Key=L_Clean}" Command="{Binding Source={StaticResource viewModelSearch}, Path=CMDClean}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Width="370" Margin="0">
      <TextBlock Name="LMovementType" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="15" Text="{Resx ResxName=ReCross.FE.Views.SearchViewConstraints, Key=L_MovementType}" />
      <RadioButton Name="RBAccount" GroupName="MovementTypeGroup" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="15" Content="{Resx ResxName=ReCross.FE.Views.SearchViewConstraints, Key=L_Account}" ToolTip="{Resx ResxName=ReCross.FE.Views.SearchViewConstraints, Key=L_AccountDescription}" IsChecked="{Binding Source={x:Static Application.Current}, Path=CurrentDataContext.DataFilters.IsAccountMovement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <RadioButton Name="RBBank" GroupName="MovementTypeGroup" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="15" Content="{Resx ResxName=ReCross.FE.Views.SearchViewConstraints, Key=L_Bank}" ToolTip="{Resx ResxName=ReCross.FE.Views.SearchViewConstraints, Key=L_BankDescription}" IsChecked="{Binding Source={x:Static Application.Current}, Path=CurrentDataContext.DataFilters.IsBankMovement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Width="570">
      <TextBlock Name="LDescription" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="15" Text="{Resx ResxName=ReCross.FE.Views.SearchViewConstraints, Key=L_Description}" />
      <TextBox Name="TBDescription" Width="460" Height="25" HorizontalAlignment="Left" FontSize="15" Text="{Binding Source={x:Static Application.Current}, Path=CurrentDataContext.DataFilters.Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding Source={x:Static Application.Current}, Path=StateData.IsNotEditingMode, UpdateSourceTrigger=PropertyChanged}" Validation.Error="InvalidType_Error" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Width="185">
      <TextBlock Name="LFromDate" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="15" Text="{Resx ResxName=ReCross.FE.Views.SearchViewConstraints, Key=L_FromDate}" />
      <TextBox Name="TBFromDate" Width="120" Height="25" HorizontalAlignment="Left" FontSize="15" Text="{Binding Source={x:Static Application.Current}, Path=CurrentDataContext.DataFilters.FromDate, Converter={x:Static strillsConverters:DateConverter.Instance}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" IsEnabled="{Binding Source={x:Static Application.Current}, Path=StateData.IsNotEditingMode, UpdateSourceTrigger=PropertyChanged}" Validation.Error="InvalidType_Error" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Width="185">
      <TextBlock Name="LToDate" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="15" Text="{Resx ResxName=ReCross.FE.Views.SearchViewConstraints, Key=L_ToDate}" />
      <TextBox Name="TBToDate" Width="120" Height="25" HorizontalAlignment="Left" FontSize="15" Text="{Binding Source={x:Static Application.Current}, Path=CurrentDataContext.DataFilters.ToDate, Converter={x:Static strillsConverters:DateConverter.Instance}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" IsEnabled="{Binding Source={x:Static Application.Current}, Path=StateData.IsNotEditingMode, UpdateSourceTrigger=PropertyChanged}" Validation.Error="InvalidType_Error" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Width="240">
      <TextBlock Name="LFromValue" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="15" Text="{Resx ResxName=ReCross.FE.Views.SearchViewConstraints, Key=L_FromValue}" />
      <TextBox Name="TBFromValue" Width="120" Height="25" HorizontalAlignment="Left" FontSize="15" Text="{Binding Source={x:Static Application.Current}, Path=CurrentDataContext.DataFilters.FromValue, Converter={x:Static strillsConverters:MoneyConverter.Instance}, ConverterParameter=true, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" IsEnabled="{Binding Source={x:Static Application.Current}, Path=StateData.IsNotEditingMode, UpdateSourceTrigger=PropertyChanged}" Validation.Error="InvalidType_Error" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Width="160">
      <TextBlock Name="LToValue" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="15" Text="{Resx ResxName=ReCross.FE.Views.SearchViewConstraints, Key=L_ToValue}" />
      <TextBox Name="TBToValue" Width="120" Height="25" HorizontalAlignment="Left" FontSize="15" Text="{Binding Source={x:Static Application.Current}, Path=CurrentDataContext.DataFilters.ToValue, Converter={x:Static strillsConverters:MoneyConverter.Instance}, ConverterParameter=true, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}" IsEnabled="{Binding Source={x:Static Application.Current}, Path=StateData.IsNotEditingMode, UpdateSourceTrigger=PropertyChanged}" Validation.Error="InvalidType_Error" />
    </StackPanel>
  </WrapPanel>
</strillsUIUserControls:UserControlFormBase>