<?xml version="1.0" encoding="utf-8"?>
<strillsUIUserControls:UserControlFormBase x:Class="ReCross.FE.Views.LoginView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:ReCross.BE.DataObjects;assembly=ReCross.BE" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" xmlns:strillsUIUserControls="clr-namespace:Strills.WPF.UI.UserControls;assembly=Strills.WPF.UI" xmlns:strillsUIControlAdapters="clr-namespace:Strills.WPF.UI.Controls.Internal;assembly=Strills.WPF.UI" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" Height="Auto" Width="Auto" xmlns:views="clr-namespace:ReCross.FE.Views" Loaded="UserControl_Loaded">
  <StackPanel Name="SPItem" MaxWidth="300" MaxHeight="550" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center" DataContext="{Binding Source={StaticResource viewModelLogin}, Path=CurrentItem}">
    <Border Style="{StaticResource entityViewBorder}">
      <WrapPanel Orientation="Horizontal" Margin="10" Height="Auto" Width="270" VerticalAlignment="Center" HorizontalAlignment="Stretch">
        <StackPanel Width="270" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
          <TextBlock Style="{StaticResource titleTextBlock}" Text="{Resx ResxName=ReCross.FE.Views.LoginView, Key=L_Authentication}" />
        </StackPanel>
        <StackPanel VerticalAlignment="Top">
          <Image Name="IUsername" Margin="10" HorizontalAlignment="Right" Width="40" Height="40" Source="..\Images\User.png" ToolTip="{Resx ResxName=ReCross.FE.Views.LoginView, Key=L_Username}" />
        </StackPanel>
        <StackPanel Width="210" VerticalAlignment="Center">
          <TextBox Name="TBUsername" Width="200" IsEnabled="True" Text="{Binding UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=Username, Mode=TwoWay}" ToolTip="{Binding ElementName=TBUsername, Path=(Validation.Errors)[0]}" Validation.Error="InvalidType_Error" />
        </StackPanel>
        <StackPanel VerticalAlignment="Top">
          <Image Name="IPassword" Margin="10" HorizontalAlignment="Right" Width="40" Height="40" Source="..\Images\Password.png" ToolTip="{Resx ResxName=ReCross.FE.Views.LoginView, Key=L_Password}" />
        </StackPanel>
        <StackPanel Width="210" VerticalAlignment="Center">
          <PasswordBox Name="PBPassword" Width="200" strillsUIControlAdapters:PasswordBoxAssistant.BindPassword="True" IsEnabled="True" strillsUIControlAdapters:PasswordBoxAssistant.BoundPassword="{Binding ValidatesOnDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True, Path=Password, Mode=TwoWay}" ToolTip="{Binding ElementName=PBPassword, Path=(Validation.Errors)[0]}" Validation.Error="InvalidType_Error" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Width="270" VerticalAlignment="Bottom" HorizontalAlignment="Center">
          <Button Name="BLogin" Style="{StaticResource formButton}" Margin="10,0,5,0" Width="120" Command="{Binding Source={StaticResource viewModelLogin}, Path=CMDLogin}" Content="{Resx ResxName=ReCross.FE.Views.LoginView, Key=B_Login}" />
          <Button Name="BClean" Style="{StaticResource formButton}" Margin="5,0,10,0" Width="120" Command="{Binding Source={StaticResource viewModelLogin}, Path=CMDClean}" Content="{Resx ResxName=ReCross.FE.Views.LoginView, Key=B_Clean}" />
        </StackPanel>
      </WrapPanel>
    </Border>
  </StackPanel>
</strillsUIUserControls:UserControlFormBase>