<?xml version="1.0" encoding="utf-8"?>
<strillsUIUserControls:UserControlItemBase x:Class="ReCross.FE.Views.SearchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:strillsUIUserControls="clr-namespace:Strills.WPF.UI.UserControls;assembly=Strills.WPF.UI" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" xmlns:converters="clr-namespace:ReCross.FE.Converters" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" xmlns:views="clr-namespace:ReCross.FE.Views" Height="Auto" Width="Auto" DataContext="{Binding Source={StaticResource viewModelSearch}, Path=DataList}" Loaded="UserControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="toolButton" TargetType="{x:Type Button}" BasedOn="{StaticResource button}">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Margin" Value="5,0,5,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel>
    <StackPanel Name="SPItemList" Style="{StaticResource itemListStackPanel}">
      <Border Style="{StaticResource entityViewBorder}">
        <WrapPanel Style="{StaticResource itemListWrapPanel}">
          <views:SearchViewConstraints />
          <views:SearchViewGrid DataContext="{Binding Source={StaticResource viewModelSearch}, Path=SearchCVS.Source, Mode=TwoWay}" />
        </WrapPanel>
      </Border>
    </StackPanel>
    <StackPanel Name="SPItem" Style="{StaticResource itemStackPanel}" />
  </StackPanel>
</strillsUIUserControls:UserControlItemBase>