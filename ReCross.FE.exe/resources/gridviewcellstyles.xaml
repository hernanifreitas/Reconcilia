<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:converters="clr-namespace:ReCross.FE.Converters" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" xmlns:reCrossBE="clr-namespace:ReCross.BE.DataObjects;assembly=ReCross.BE" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" xmlns:strillsConverters="clr-namespace:Strills.WPF.Localization.Converters;assembly=Strills.WPF.Localization">
  <DataTemplate x:Key="cellDescription">
    <TextBlock Text="{Binding Path=Description}" ToolTip="{Binding Path=Description}" />
  </DataTemplate>
  <DataTemplate x:Key="cellAmountInverted">
    <TextBlock HorizontalAlignment="Right" TextAlignment="Right" Foreground="{Binding Path=Amount, Converter={x:Static strillsConverters:MoneyColorConverter.Instance}, ConverterParameter=true}" Text="{Binding Path=Amount, Converter={x:Static strillsConverters:MoneyConverter.Instance}, ConverterParameter=true}" />
  </DataTemplate>
  <DataTemplate x:Key="cellAmount">
    <TextBlock HorizontalAlignment="Right" TextAlignment="Right" Foreground="{Binding Path=Amount, Converter={x:Static strillsConverters:MoneyColorConverter.Instance}}" Text="{Binding Path=Amount, Converter={x:Static strillsConverters:MoneyConverter.Instance}, ConverterParameter=true}" />
  </DataTemplate>
  <DataTemplate x:Key="cellCheck">
    <Button ToolTip="Marcar registo" Style="{StaticResource gridButton}" Command="{Binding Path=CMDUpdateItems, Source={StaticResource viewModelReconciliation}}" CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListView}}}">
      <Control.Background>
        <ImageBrush ImageSource="..\Images\Check.png" />
      </Control.Background>
      <strillsUICommands:CommandBehaviorCollection.Behaviors>
        <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Path=CMDCheckItem, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewExtended}}}" CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItemExtended}}}" />
      </strillsUICommands:CommandBehaviorCollection.Behaviors>
    </Button>
  </DataTemplate>
  <DataTemplate x:Key="cellEdit">
    <Control Name="toolBar" Focusable="False" Width="90">
      <Control.Template>
        <ControlTemplate>
          <StackPanel Orientation="Horizontal" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Name="BEdit" Style="{StaticResource gridButton}" ToolTip="{Resx ResxName=Strills.WPF.Localization.Resources.ToolBar, Key=L_Edit}" IsEnabled="{Binding Source={x:Static Application.Current}, Path=StateData.IsNotEditingMode, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Path=DataContext.PermissionData.CanUpdate, Converter={x:Static converters:VisibilityAsDataConverter.Instance}, ConverterParameter=Visible, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItemExtended}}}">
              <Control.Background>
                <ImageBrush ImageSource="..\Images\Edit.png" />
              </Control.Background>
              <strillsUICommands:CommandBehaviorCollection.Behaviors>
                <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Path=CMDEditItem, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewExtended}}}" CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItemExtended}}}" />
                <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Path=CommandEditItem, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewExtended}}}" />
              </strillsUICommands:CommandBehaviorCollection.Behaviors>
            </Button>
          </StackPanel>
        </ControlTemplate>
      </Control.Template>
    </Control>
    <DataTemplate.Triggers>
      <DataTrigger Value="True" Binding="{Binding Path=IsEdited, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItemExtended}}}">
        <Setter TargetName="toolBar" Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <StackPanel Orientation="Horizontal" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Name="BConfirm" Style="{StaticResource gridButton}" ToolTip="{Resx ResxName=Strills.WPF.Localization.Resources.ToolBar, Key=L_Confirm}">
                  <Control.Background>
                    <ImageBrush ImageSource="..\Images\Confirm.png" />
                  </Control.Background>
                  <strillsUICommands:CommandBehaviorCollection.Behaviors>
                    <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Path=CommandConfirm, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewExtended}}}" />
                    <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Path=CMDConfirmItem, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewExtended}}}" CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItemExtended}}}" />
                  </strillsUICommands:CommandBehaviorCollection.Behaviors>
                </Button>
                <Button Name="BCancel" Style="{StaticResource gridButton}" ToolTip="{Resx ResxName=Strills.WPF.Localization.Resources.ToolBar, Key=L_Cancel}">
                  <Control.Background>
                    <ImageBrush ImageSource="..\Images\Cancel.png" />
                  </Control.Background>
                  <strillsUICommands:CommandBehaviorCollection.Behaviors>
                    <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Path=CommandCancel, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewExtended}}}" />
                    <strillsUICommands:BehaviorBinding Event="Click" Command="{Binding Path=CMDCancelItem, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewExtended}}}" CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItemExtended}}}" />
                  </strillsUICommands:CommandBehaviorCollection.Behaviors>
                </Button>
              </StackPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>