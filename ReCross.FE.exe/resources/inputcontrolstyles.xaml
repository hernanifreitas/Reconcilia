<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" xmlns:reCrossBE="clr-namespace:ReCross.BE.DataObjects;assembly=ReCross.BE" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" xmlns:strillsUIUserControls="clr-namespace:Strills.WPF.UI.UserControls;assembly=Strills.WPF.UI">
  <Style x:Key="focusStyle" TargetType="{x:Type Control}">
    <Setter Property="Template" Value="{x:Null}" />
  </Style>
  <Style x:Key="button" TargetType="{x:Type Button}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource focusStyle}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
  </Style>
  <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource button}" />
  <Style x:Key="formButton" TargetType="{x:Type Button}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource focusStyle}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Width" Value="200" />
    <Setter Property="Width" Value="200" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Border" SnapsToDevicePixels="True" Cursor="Hand" Background="#526478" CornerRadius="10,0,10,0" Height="25">
            <ContentPresenter ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Border.Background" Value="#7F97B1" />
              <Setter Property="Foreground" Value="#FFF0F8FF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="Border.Background" Value="#FFF0F8FF" />
              <Setter Property="Foreground" Value="#FF808080" />
            </Trigger>
            <Trigger Property="UIElement.IsFocused" Value="True">
              <Setter TargetName="Border" Property="Border.BorderBrush" Value="#FFF0F8FF" />
              <Setter TargetName="Border" Property="Border.BorderThickness" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="gridButton" TargetType="{x:Type Button}" BasedOn="{StaticResource button}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
  </Style>
  <Style x:Key="textBlock" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource textBlock}" />
  <Style x:Key="formTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource textBlock}">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="rightTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource formTextBlock}">
    <Setter Property="TextBlock.TextAlignment" Value="Right" />
    <Setter Property="TextBlock.Padding" Value="10,0,10,30" />
  </Style>
  <Style x:Key="titleTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource formTextBlock}">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextBlock.Padding" Value="0" />
  </Style>
  <DataTemplate x:Key="{DataTemplateKey {x:Type ValidationError}}" DataType="{x:Type ValidationError}">
    <TextBlock FontStyle="Italic" Foreground="#FFFF0000" FontSize="12" HorizontalAlignment="Left" Margin="0,1" Text="{Binding Path=ErrorContent}" />
  </DataTemplate>
  <Style x:Key="inputFieldTemplate" TargetType="{x:Type Control}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Margin" Value="0,5" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="IsEnabled" Value="{Binding Source={x:Static Application.Current}, Path=StateData.IsEditingMode, UpdateSourceTrigger=PropertyChanged}" />
    <Setter Property="Validation.ErrorTemplate">
      <Setter.Value>
        <ControlTemplate>
          <AdornedElementPlaceholder />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Validation.HasError" Value="True">
        <Setter Property="FrameworkElement.ToolTip" Value="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=(Validation.Errors)[0].ErrorContent}" />
        <Setter Property="BorderBrush" Value="#FFFF0000" />
        <Setter Property="BorderThickness" Value="2" />
      </Trigger>
      <Trigger Property="Validation.HasError" Value="False">
        <Setter Property="FrameworkElement.ToolTip" Value="" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{StaticResource inputFieldTemplate}" />
  <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource inputFieldTemplate}" />
  <Style x:Key="{x:Type ComboBoxExtended}" TargetType="{x:Type ComboBoxExtended}" BasedOn="{StaticResource {x:Type ComboBox}}" />
  <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource inputFieldTemplate}" />
  <Style x:Key="{x:Type PasswordBox}" TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource inputFieldTemplate}" />
</ResourceDictionary>