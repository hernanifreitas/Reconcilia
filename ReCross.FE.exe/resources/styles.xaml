<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:converters="clr-namespace:ReCross.FE.Converters" xmlns:viewModels="clr-namespace:ReCross.FE.ViewModels" xmlns:reCrossBE="clr-namespace:ReCross.BE.DataObjects;assembly=ReCross.BE" xmlns:strillsUICommands="clr-namespace:Strills.WPF.UI.Commands;assembly=Strills.WPF.UI" xmlns:strillsUIUserControls="clr-namespace:Strills.WPF.UI.UserControls;assembly=Strills.WPF.UI">
  <Style x:Key="columnHeaderBorder" TargetType="{x:Type Border}">
    <Style.Triggers>
      <Trigger Property="UIElement.IsFocused" Value="True">
        <Setter Property="Background" Value="#FF808080" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="gridViewHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
          <Border Name="Border" SnapsToDevicePixels="True" Cursor="Hand" Background="#FFF0F8FF" CornerRadius="10,0,10,0" Height="33" BorderBrush="#00FFFFFF" BorderThickness="1">
            <ContentPresenter ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Border.Background" Value="#c5d7e5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="itemGridViewStyle" TargetType="{x:Type ListViewItemExtended}">
    <Style.Resources>
      <ResourceDictionary>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="DarkGray" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="DarkGray" />
      </ResourceDictionary>
    </Style.Resources>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="#FF000000" />
    <Setter Property="BorderThickness" Value="1,1,0,0" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource focusStyle}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListViewItemExtended}">
          <Border Name="Border" Padding="0" SnapsToDevicePixels="True" CornerRadius="10,0,10,0" Margin="0,2,0,0">
            <GridViewRowPresenter Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
              <Setter TargetName="Border" Property="Border.Background" Value="#A5FFFFFF" />
            </Trigger>
            <Trigger Property="ItemsControl.AlternationIndex" Value="2">
              <Setter TargetName="Border" Property="Border.Background" Value="#00FFFFFF" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="Border" Property="Border.Background" Value="#8099b4" />
              <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Border.Background" Value="#c5d7e5" />
              <Setter Property="Foreground" Value="#000000" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="#000000" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="itemStyle" TargetType="{x:Type ListViewItemExtended}" BasedOn="{StaticResource itemGridViewStyle}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <DataTemplate x:Key="headerTemplateArrowUp">
    <DockPanel>
      <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="{Binding}" />
      <Path Name="arrow" StrokeThickness="1" Fill="#FF808080" Data="M5,10 L15,10 L10,5 L5,10" />
    </DockPanel>
  </DataTemplate>
  <DataTemplate x:Key="headerTemplateArrowDown">
    <DockPanel>
      <TextBlock HorizontalAlignment="Center" FontWeight="Bold" Text="{Binding}" />
      <Path Name="arrow" StrokeThickness="1" Fill="#FF808080" Data="M5,5 L10,10 L15,5 L5,5" />
    </DockPanel>
  </DataTemplate>
  <DataTemplate x:Key="headerTemplateTransparent">
    <DockPanel>
      <TextBlock HorizontalAlignment="Center" Text="{Binding}" />
      <Path Name="arrow" StrokeThickness="1" Fill="#00FFFFFF" Data="M5,5 L10,10 L15,5 L5,5" />
    </DockPanel>
  </DataTemplate>
  <Style x:Key="formListView" TargetType="{x:Type ListViewExtended}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource focusStyle}" />
    <Setter Property="MaxHeight" Value="510" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Selector.IsSynchronizedWithCurrentItem" Value="True" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource itemGridViewStyle}" />
    <Setter Property="ListViewExtended.ColumnHeaderSortedAscendingTemplate" Value="headerTemplateArrowUp" />
    <Setter Property="ListViewExtended.ColumnHeaderSortedDescendingTemplate" Value="headerTemplateArrowDown" />
    <Setter Property="ListViewExtended.ColumnHeaderNotSortedTemplate" Value="headerTemplateTransparent" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style x:Key="{x:Type ListViewExtended}" TargetType="{x:Type ListViewExtended}" BasedOn="{StaticResource formListView}" />
