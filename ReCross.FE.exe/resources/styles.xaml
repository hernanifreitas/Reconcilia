            <Button Name="BEdit" Style="{StaticResource gridButton}" ToolTip="{Resx ResxName=Strills.WPF.Localization.Resources.ToolBar, Key=L_Edit}" IsEnabled="{Binding Source={x:Static Application.Current}, Path=StateData.IsEditingMode, UpdateSourceTrigger=PropertyChanged}">
