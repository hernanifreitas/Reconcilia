        <Control.Background>
          <ImageBrush ImageSource="..\Images\Add.png" />
        </Control.Background>
        <strillsUICommands:CommandBehaviorCollection.Behaviors>
          <strillsUICommands:BehaviorBinding Event="Click" Command="strillsUIUserControls:UserControlItemBase.CMDViewItem" />
